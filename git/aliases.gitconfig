# git/aliases.gitconfig — the shared [alias] section, and ONLY that.
#
# Consumed by every machine's own ~/.gitconfig through an include:
#
#   [include]
#       path = <XDG_CONFIG_HOME>/git/aliases.gitconfig
#
# install.sh links $XDG_CONFIG_HOME/git/aliases.gitconfig at this file and adds
# that include line (idempotently) to the global git config. The rest of the git
# config — user identity, credential helpers, per-machine tweaks — stays in each
# machine's ~/.gitconfig and MUST NOT move here: this file is symlinked from a
# public repo, and this repo deliberately never becomes a `git config --global`
# write target (that is why the link is named `aliases.gitconfig`, not the
# auto-read `config` slot — see install.sh).
#
# There is NO `echo` in the alias bodies, ON PURPOSE — banners and data alike
# go through printf. git runs `!` aliases with /bin/sh, which is dash on the
# Linux box (its echo interprets backslash escapes) but bash on macOS (its
# echo does NOT), so any echo renders differently on the two machines. For the
# \033 banners that meant a literal `\033[90m…` instead of color on the Mac;
# for echoed DATA (an author name like `Bad\nname` — one env var away in a
# hostile clone) it meant dash shattering recent-files' aligned row while the
# Mac printed it intact. printf behaves identically under both: \ddd octal in
# the FORMAT string is POSIX, and data rides in %s arguments, which are never
# escape-processed (%b would be; do not use it).
#
# Every multi-line lister ends in `| less -RFX` — one pager rule for the file:
# short output prints straight through (-F), long output pages with colors
# intact (-R) and stays on the scrollback afterwards (-X), and pipes pass
# untouched (less degrades to cat when stdout is not a tty). lg, lo and
# last-touch are exempt on purpose: their inner `git log` brings git's own
# pager, which behaves the same way (git sets LESS=FRX).
#
# Colors are tty-gated: every body opens with one [ -t 1 ] / NO_COLOR preamble
# defining the palette (gry bcy yel byl cyn mag grn rst) as real ESC bytes —
# made with $(printf), so no later stage ever has to escape-process them — or
# as empty strings when stdout is a pipe or file. `git branches > notes.txt`
# greps like plain text, matching what git itself already did for lg/lo's
# %C() colors. awk receives the palette through -v variables; their values
# contain no backslashes, so awk's -v escape processing cannot touch them.

[alias]
    # ╔══════════════════════════════════════════════╗
    # ║           EXPLORATION & DISCOVERY            ║
    # ╚══════════════════════════════════════════════╝

    # Beautiful branch graph log
    lg = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git lg [count] [-- path]  │  Graph log with colors and alignment (default: 30)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=30; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git log --graph --pretty=format:\"\
%C(bold yellow)%h%C(reset) \
%C(bold cyan)%ad%C(reset) \
%C(dim white)│%C(reset) \
%C(bold magenta)%<(14,trunc)%an%C(reset) \
%C(dim white)│%C(reset) \
%C(white)%s%C(reset)\
%C(auto)%d\" --date=short -\"$n\" \"$@\"; \
    }; f"

    # Compact one-line log with graph
    lo = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git lo [count] [-- path]  │  Compact one-line log with graph (default: 20)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=20; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git log --graph --pretty=format:\"\
%C(bold yellow)●%C(reset) \
%C(yellow)%h%C(reset) \
%C(white)%s%C(reset) \
%C(dim cyan)(%ar)%C(reset)\
%C(auto)%d\" --date=short -\"$n\" \"$@\"; \
    }; f"

    # Show recent activity with file paths, piped to pager
    activity = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git activity [count] [-- path]  │  Recent commits with file tree (default: 15)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=15; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git log --pretty=format:'%h|%ad|%<(12,trunc)%an|%s' --date=short -\"$n\" --name-only \"$@\" \
        | awk -F'|' -v gry=\"$gry\" -v byl=\"$byl\" -v cyn=\"$cyn\" -v mag=\"$mag\" -v rst=\"$rst\" ' \
            /^$/ { next } \
            NF>=4 { \
                if (fc>0) { for(i=1;i<=fc;i++) { conn=(i<fc)?\"├─\":\"└─\"; printf \"%s       %s %s%s\\n\",gry,conn,files[i],rst } } \
                printf \"\\n%s  %s %s%s %s%s %s%s\\n\",byl,$1,cyn,$2,mag,$3,rst,$4; \
                fc=0; delete files; next \
            } \
            { files[++fc]=$0 } \
            END { if (fc>0) { for(i=1;i<=fc;i++) { conn=(i<fc)?\"├─\":\"└─\"; printf \"%s       %s %s%s\\n\",gry,conn,files[i],rst } } } \
        ' \
        | less -RFX; \
    }; f"

    # Files sorted by most recently modified
    recent-files = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git recent-files [count] [-- path]  │  Files sorted by last modified (default: 25)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=25; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git -c core.quotepath=false log --all --date=short --name-only --diff-filter=AMR \
            --pretty=format:'%x01%ad%x01%<(16,trunc)%ar%x01%<(20,trunc)%an' \"$@\" \
        | awk -v n=\"$n\" -v yel=\"$yel\" -v cyn=\"$cyn\" -v gry=\"$gry\" -v rst=\"$rst\" ' \
            BEGIN { while ((\"git -c core.quotepath=false ls-files\" | getline l) > 0) t[l]=1 } \
            substr($0,1,1)==\"\\001\" { split(substr($0,2), h, \"\\001\"); next } \
            $0==\"\" { next } \
            !($0 in t) { next } \
            !seen[$0]++ { \
                printf \"%s  %s  %s%s  %s%s%s%s\\n\", yel, h[1], cyn, h[2], gry, h[3], rst, $0; \
                if (++c>=n) exit \
            } \
        ' | less -RFX; \
    }; f"

    # Recently changed directories with aligned bar chart
    recent-dirs = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git recent-dirs [days] [-- path]  │  Directory change frequency bar chart (default: 7 days)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        days=7; if [ \"$1\" -gt 0 ] 2>/dev/null; then days=$1; shift; fi; \
        git log --since=\"${days} days ago\" --name-only --pretty=format: \"$@\" \
        | sed -e '/^$/d' -e 's|^[^/]*$|.|' -e 's|/[^/]*$||' \
        | sort | uniq -c | sort -rn \
        | awk -v yel=\"$yel\" -v cyn=\"$cyn\" -v grn=\"$grn\" -v rst=\"$rst\" '{ \
            count=$1; \
            dir=\"\"; for(i=2;i<=NF;i++) dir=dir (i>2?\" \":\"\") $i; \
            if(length(dir)>max) max=length(dir); \
            counts[NR]=count; dirs[NR]=dir; total=NR \
        } END { \
            scale=(counts[1]>40)?40/counts[1]:1; \
            for(i=1;i<=total;i++) { \
                w=int(counts[i]*scale); if(w<1) w=1; \
                bar=\"\"; for(j=0;j<w;j++) bar=bar\"█\"; \
                printf \"%s  %3d  %s%-*s  %s%s%s\\n\", yel, counts[i], cyn, max, dirs[i], grn, bar, rst \
            } \
        }' | less -RFX; \
    }; f"

    # Deep inspect a file's history
    last-touch = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git last-touch <path> [count]  │  Recent commit history for a file (default: 5)'; \
        if [ -z \"$1\" ] || [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=${2:-5}; \
        git log -\"$n\" --pretty=format:\"%C(yellow)  %h  %C(cyan)%ad  %C(dim cyan)(%ar)%C(reset)%n       %s%n%C(dim white)       by %an%C(reset)%n\" --date=short -- \"$1\"; \
    }; f"


    # ╔══════════════════════════════════════════════╗
    # ║             BRANCH MANAGEMENT                ║
    # ╚══════════════════════════════════════════════╝

    # List branches sorted by last commit date
    branches = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git branches [count]  │  Branches sorted by last commit date (default: 20)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=20; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; fi; \
        git branch -a --sort=-committerdate --format='%(refname:short)|%(committerdate:short)|%(authorname)|%(subject)' \
        | head -\"$n\" \
        | awk -F'|' -v byl=\"$byl\" -v cyn=\"$cyn\" -v mag=\"$mag\" -v rst=\"$rst\" '{ \
            if(length($1)>bmax) bmax=length($1); \
            if(length($3)>amax) amax=length($3); \
            b[NR]=$1; d[NR]=$2; a[NR]=$3; s[NR]=$4; total=NR \
        } END { \
            for(i=1;i<=total;i++) { \
                printf \"%s  %-*s  %s%s  %s%-*s  %s%s\\n\", byl, bmax, b[i], cyn, d[i], mag, amax, a[i], rst, s[i] \
            } \
        }' | less -RFX; \
    }; f"

    # Show who's been working on what
    team = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git team [days] [-- path]  │  Contributor activity bar chart (default: 30 days)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        days=30; if [ \"$1\" -gt 0 ] 2>/dev/null; then days=$1; shift; fi; \
        git shortlog -sn --since=\"${days} days ago\" --no-merges \"$@\" \
        | awk -v yel=\"$yel\" -v cyn=\"$cyn\" -v grn=\"$grn\" -v rst=\"$rst\" '{ \
            count=$1; name=substr($0, index($0,$2)); \
            if (NR==1) scale=(count>40)?40/count:1; \
            w=int(count*scale); if(w<1) w=1; \
            bar=\"\"; for(i=0;i<w;i++) bar=bar\"█\"; \
            printf \"%s  %4d  %s%-25s  %s%s%s\\n\", yel, count, cyn, name, grn, bar, rst \
        }' | less -RFX; \
    }; f"


    # ╔══════════════════════════════════════════════╗
    # ║                 SHORTCUTS                    ║
    # ╚══════════════════════════════════════════════╝

    co = checkout
    br = branch
    ci = commit
    undo = reset --soft HEAD~1
    amend = commit --amend --no-edit
    stash-all = stash push --include-untracked

    # List all aliases with descriptions
    aliases = "!f() { \
        printf '\\n\\033[1;36m  Custom Git Aliases\\033[0m\\n\\033[90m  ──────────────────────────────────────────────────────────────────\\033[0m\\n\\n'; \
        git config --get-regexp ^alias\\. | sed 's/^alias\\.\\([^ ]*\\) .*/\\1/' | sort -u | while read -r name; do \
            case \"$name\" in \
                lg)           desc='Graph log with colors and alignment';; \
                lo)           desc='Compact one-line log with graph';; \
                activity)     desc='Recent commits with file tree';; \
                recent-files) desc='Files sorted by last modified';; \
                recent-dirs)  desc='Directory change frequency bar chart';; \
                last-touch)   desc='Recent commit history for a file';; \
                branches)     desc='Branches sorted by last commit date';; \
                team)         desc='Contributor activity bar chart';; \
                co)           desc='Shortcut for checkout';; \
                br)           desc='Shortcut for branch';; \
                ci)           desc='Shortcut for commit';; \
                undo)         desc='Soft reset last commit';; \
                amend)        desc='Amend last commit (no edit)';; \
                stash-all)    desc='Stash including untracked files';; \
                aliases)      desc='List all aliases with descriptions';; \
                *)            desc='';; \
            esac; \
            printf '\\033[1;33m  %-16s \\033[90m%s\\033[0m\\n' \"$name\" \"$desc\"; \
        done; \
        printf '\\n\\033[90m  Run git <alias> -h for usage details\\033[0m\\n\\n'; \
    }; f"
