# git/aliases.gitconfig — the shared [alias] section, and ONLY that.
#
# Consumed by every machine's own ~/.gitconfig through an include:
#
#   [include]
#       path = <XDG_CONFIG_HOME>/git/aliases.gitconfig
#
# install.sh links $XDG_CONFIG_HOME/git/aliases.gitconfig at this file and adds
# that include line (idempotently) to the global git config. The rest of the git
# config — user identity, credential helpers, per-machine tweaks — stays in each
# machine's ~/.gitconfig and MUST NOT move here: this file is symlinked from a
# public repo, and this repo deliberately never becomes a `git config --global`
# write target (that is why the link is named `aliases.gitconfig`, not the
# auto-read `config` slot — see install.sh).
#
# There is NO `echo` in the alias bodies, ON PURPOSE — banners and data alike
# go through printf. git runs `!` aliases with /bin/sh, which is dash on the
# Linux box (its echo interprets backslash escapes) but bash on macOS (its
# echo does NOT), so any echo renders differently on the two machines. For the
# \033 banners that meant a literal `\033[90m…` instead of color on the Mac;
# for echoed DATA (an author name like `Bad\nname` — one env var away in a
# hostile clone) it meant dash shattering recent-files' aligned row while the
# Mac printed it intact. printf behaves identically under both: \ddd octal in
# the FORMAT string is POSIX, and data rides in %s arguments, which are never
# escape-processed (%b would be; do not use it).
#
# Every multi-line lister ends in `| less -RFX` — one pager rule for the file:
# short output prints straight through (-F), long output pages with colors
# intact (-R) and stays on the scrollback afterwards (-X), and pipes pass
# untouched (less degrades to cat when stdout is not a tty). lg, lo and
# last-touch are exempt on purpose: their inner `git log` brings git's own
# pager, which behaves the same way (git sets LESS=FRX).
#
# Colors are tty-gated: every body opens with one [ -t 1 ] / NO_COLOR preamble
# defining the palette (gry bcy yel byl cyn mag grn rst) as real ESC bytes —
# made with $(printf), so no later stage ever has to escape-process them — or
# as empty strings when stdout is a pipe or file. `git branches > notes.txt`
# greps like plain text, matching what git itself already did for lg/lo's
# %C() colors. awk receives the palette through -v variables; their values
# contain no backslashes, so awk's -v escape processing cannot touch them.

[alias]
    # ╔══════════════════════════════════════════════╗
    # ║           EXPLORATION & DISCOVERY            ║
    # ╚══════════════════════════════════════════════╝

    # Beautiful branch graph log
    lg = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git lg [count] [-- path]  │  Graph log with colors and alignment (default: 30)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=30; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git log --graph --pretty=format:\"\
%C(bold yellow)%h%C(reset) \
%C(bold cyan)%ad%C(reset) \
%C(dim white)│%C(reset) \
%C(bold magenta)%<(14,trunc)%an%C(reset) \
%C(dim white)│%C(reset) \
%C(white)%s%C(reset)\
%C(auto)%d\" --date=short -\"$n\" \"$@\"; \
    }; f"

    # Compact one-line log with graph
    lo = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git lo [count] [-- path]  │  Compact one-line log with graph (default: 20)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=20; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git log --graph --pretty=format:\"\
%C(bold yellow)●%C(reset) \
%C(yellow)%h%C(reset) \
%C(white)%s%C(reset) \
%C(dim cyan)(%ar)%C(reset)\
%C(auto)%d\" --date=short -\"$n\" \"$@\"; \
    }; f"

    # Show recent activity with file paths, piped to pager
    activity = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git activity [count] [-- path]  │  Recent commits with file tree (default: 15)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=15; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git log --pretty=format:'%h|%ad|%<(12,trunc)%an|%s' --date=short -\"$n\" --name-only \"$@\" \
        | awk -F'|' -v gry=\"$gry\" -v byl=\"$byl\" -v cyn=\"$cyn\" -v mag=\"$mag\" -v rst=\"$rst\" ' \
            /^$/ { next } \
            NF>=4 { \
                if (fc>0) { for(i=1;i<=fc;i++) { conn=(i<fc)?\"├─\":\"└─\"; printf \"%s       %s %s%s\\n\",gry,conn,files[i],rst } } \
                printf \"\\n%s  %s %s%s %s%s %s%s\\n\",byl,$1,cyn,$2,mag,$3,rst,$4; \
                fc=0; delete files; next \
            } \
            { files[++fc]=$0 } \
            END { if (fc>0) { for(i=1;i<=fc;i++) { conn=(i<fc)?\"├─\":\"└─\"; printf \"%s       %s %s%s\\n\",gry,conn,files[i],rst } } } \
        ' \
        | less -RFX; \
    }; f"

    # Files sorted by most recently modified
    recent-files = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git recent-files [count] [-- path]  │  Files sorted by last modified (default: 25)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=25; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git -c core.quotepath=false log --all --date=short --name-only --diff-filter=AMR \
            --pretty=format:'%x01%ad%x01%<(16,trunc)%ar%x01%<(20,trunc)%an' \"$@\" \
        | awk -v n=\"$n\" -v yel=\"$yel\" -v cyn=\"$cyn\" -v gry=\"$gry\" -v rst=\"$rst\" ' \
            BEGIN { while ((\"git -c core.quotepath=false ls-files\" | getline l) > 0) t[l]=1 } \
            substr($0,1,1)==\"\\001\" { split(substr($0,2), h, \"\\001\"); next } \
            $0==\"\" { next } \
            !($0 in t) { next } \
            !seen[$0]++ { \
                printf \"%s  %s  %s%s  %s%s%s  %s\\n\", yel, h[1], cyn, h[2], gry, h[3], rst, $0; \
                if (++c>=n) exit \
            } \
        ' | less -RFX; \
    }; f"

    # Recently changed directories with aligned bar chart
    recent-dirs = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git recent-dirs [days] [-- path]  │  Directory change frequency bar chart (default: 7 days)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        days=7; if [ \"$1\" -gt 0 ] 2>/dev/null; then days=$1; shift; fi; \
        git log --since=\"${days} days ago\" --name-only --pretty=format: \"$@\" \
        | sed -e '/^$/d' -e 's|^[^/]*$|.|' -e 's|/[^/]*$||' \
        | sort | uniq -c | sort -rn \
        | awk -v yel=\"$yel\" -v cyn=\"$cyn\" -v grn=\"$grn\" -v rst=\"$rst\" '{ \
            count=$1; \
            dir=\"\"; for(i=2;i<=NF;i++) dir=dir (i>2?\" \":\"\") $i; \
            if(length(dir)>max) max=length(dir); \
            counts[NR]=count; dirs[NR]=dir; total=NR \
        } END { \
            scale=(counts[1]>40)?40/counts[1]:1; \
            for(i=1;i<=total;i++) { \
                w=int(counts[i]*scale); if(w<1) w=1; \
                bar=\"\"; for(j=0;j<w;j++) bar=bar\"█\"; \
                printf \"%s  %3d  %s%-*s  %s%s%s\\n\", yel, counts[i], cyn, max, dirs[i], grn, bar, rst \
            } \
        }' | less -RFX; \
    }; f"

    # Deep inspect a file's history
    last-touch = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git last-touch <path> [count]  │  Recent commit history for a file (default: 5)'; \
        if [ -z \"$1\" ] || [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=${2:-5}; \
        git log -\"$n\" --pretty=format:\"%C(yellow)  %h  %C(cyan)%ad  %C(dim cyan)(%ar)%C(reset)%n       %s%n%C(dim white)       by %an%C(reset)%n\" --date=short -- \"$1\"; \
    }; f"


    # ╔══════════════════════════════════════════════╗
    # ║             BRANCH MANAGEMENT                ║
    # ╚══════════════════════════════════════════════╝

    # List branches sorted by last commit date
    branches = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git branches [count]  │  Branches sorted by last commit date (default: 20)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=20; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; fi; \
        git branch -a --sort=-committerdate --format='%(refname:short)|%(committerdate:short)|%(authorname)|%(subject)' \
        | head -\"$n\" \
        | awk -F'|' -v byl=\"$byl\" -v cyn=\"$cyn\" -v mag=\"$mag\" -v rst=\"$rst\" '{ \
            if(length($1)>bmax) bmax=length($1); \
            if(length($3)>amax) amax=length($3); \
            b[NR]=$1; d[NR]=$2; a[NR]=$3; s[NR]=$4; total=NR \
        } END { \
            for(i=1;i<=total;i++) { \
                printf \"%s  %-*s  %s%s  %s%-*s  %s%s\\n\", byl, bmax, b[i], cyn, d[i], mag, amax, a[i], rst, s[i] \
            } \
        }' | less -RFX; \
    }; f"

    # Show who's been working on what
    team = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git team [days] [-- path]  │  Contributor activity bar chart (default: 30 days)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        days=30; if [ \"$1\" -gt 0 ] 2>/dev/null; then days=$1; shift; fi; \
        if ! git rev-parse -q --verify HEAD >/dev/null 2>&1; then printf '%s  no commits yet%s\\n' \"$yel\" \"$rst\"; return 1; fi; \
        git shortlog -sn --since=\"${days} days ago\" --no-merges \"$@\" \
        | awk -v yel=\"$yel\" -v cyn=\"$cyn\" -v grn=\"$grn\" -v rst=\"$rst\" '{ \
            count=$1; name=substr($0, index($0,$2)); \
            if (NR==1) scale=(count>40)?40/count:1; \
            w=int(count*scale); if(w<1) w=1; \
            bar=\"\"; for(i=0;i<w;i++) bar=bar\"█\"; \
            printf \"%s  %4d  %s%-25s  %s%s%s\\n\", yel, count, cyn, name, grn, bar, rst \
        }' | less -RFX; \
    }; f"


    # ╔══════════════════════════════════════════════╗
    # ║              AUDIT & TRIAGE                  ║
    # ╚══════════════════════════════════════════════╝

    # First look at an unfamiliar clone: one screen of facts before any code
    overview = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); red=$(printf '\\033[31m'); brd=$(printf '\\033[1;31m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; red=; brd=; fi; \
        _help='git overview [count] [-- path]  │  One-screen repo triage: age, authors, tags, languages (default: 6 languages)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=6; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        if ! git rev-parse -q --verify HEAD >/dev/null 2>&1; then printf '%s  no commits yet%s\\n' \"$red\" \"$rst\"; return 1; fi; \
        head_ref=$(git symbolic-ref --short -q HEAD); [ -n \"$head_ref\" ] || head_ref='(detached)'; \
        head_sha=$(git rev-parse --short HEAD); \
        commits=$(git rev-list --count HEAD \"$@\"); \
        if [ \"${commits:-0}\" -eq 0 ] 2>/dev/null; then printf '%s  no commits match %s%s\\n' \"$red\" \"$*\" \"$rst\"; return 1; fi; \
        first=$(git log --format=%ad --date=short HEAD \"$@\" | tail -1); \
        last=$(git log -1 --format='%ad (%ar)' --date=short HEAD \"$@\"); \
        authors=$(git log --format=%an HEAD \"$@\" | awk '!seen[$0]++ { c++ } END { print c+0 }'); \
        tags=$(git tag | awk 'END { print NR }'); \
        latest=$(git tag --sort=-creatordate | head -1); [ -n \"$latest\" ] || latest='(none)'; \
        locals=$(git for-each-ref --format='%(refname)' refs/heads | awk 'END { print NR }'); \
        remotes=$(git for-each-ref --format='%(refname)' refs/remotes | awk 'END { print NR }'); \
        files=$(git ls-files \"$@\" | awk 'END { print NR }'); \
        printf '\\n%s  Repository Overview%s\\n%s  ──────────────────────────────────────────────────────────────────%s\\n' \"$bcy\" \"$rst\" \"$gry\" \"$rst\"; \
        printf '%s  %-10s%s  %s%s%s %s@ %s%s\\n' \"$cyn\" 'head' \"$rst\" \"$byl\" \"$head_ref\" \"$rst\" \"$gry\" \"$head_sha\" \"$rst\"; \
        printf '%s  %-10s%s  %s → %s\\n' \"$cyn\" 'span' \"$rst\" \"$first\" \"$last\"; \
        printf '%s  %-10s%s  %s commits by %s authors\\n' \"$cyn\" 'history' \"$rst\" \"$commits\" \"$authors\"; \
        printf '%s  %-10s%s  %s local, %s remote\\n' \"$cyn\" 'branches' \"$rst\" \"$locals\" \"$remotes\"; \
        printf '%s  %-10s%s  %s (latest: %s)\\n' \"$cyn\" 'tags' \"$rst\" \"$tags\" \"$latest\"; \
        printf '%s  %-10s%s  %s tracked\\n' \"$cyn\" 'files' \"$rst\" \"$files\"; \
        if [ -e .gitmodules ]; then \
            subs=$(git config -f .gitmodules --get-regexp 'submodule\\..*\\.path' 2>/dev/null | awk 'END { print NR }'); \
            printf '%s  %-10s%s  %s%s — inspect .gitmodules%s\\n' \"$cyn\" 'submodules' \"$rst\" \"$brd\" \"$subs\" \"$rst\"; \
        fi; \
        printf '%s  %-10s%s\\n' \"$cyn\" 'languages' \"$rst\"; \
        git ls-files \"$@\" \
        | awk -F/ '{ b=$NF; k=split(b, p, \".\"); if (k>1 && p[1]!=\"\") e=\".\" p[k]; else e=\"(none)\"; c[e]++ } END { for (e in c) printf \"%d %s\\n\", c[e], e }' \
        | sort -rn | head -\"$n\" \
        | awk -v yel=\"$yel\" -v cyn=\"$cyn\" -v grn=\"$grn\" -v rst=\"$rst\" '{ \
            c=$1+0; line=$0; sub(/^[ \\t]*[0-9]+[ \\t]/, \"\", line); \
            if (c>cmax) cmax=c; if (length(line)>emax) emax=length(line); \
            counts[NR]=c; exts[NR]=line; total=NR \
        } END { \
            for (i=1;i<=total;i++) { \
                w=int(counts[i]*24/cmax); if (w<1) w=1; \
                bar=\"\"; for (j=0;j<w;j++) bar=bar\"█\"; \
                printf \"%s  %8d  %s%-*s  %s%s%s\\n\", yel, counts[i], cyn, emax, exts[i], grn, bar, rst \
            } \
        }'; \
        printf '\\n'; \
    }; f"

    # Pickaxe wrapper: when did a string enter or leave the codebase
    when = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git when <text> [count] [-- path]  │  Commits that added/removed <text>, with files (default: 10)'; \
        if [ -z \"$1\" ] || [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        text=$1; shift; \
        n=10; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git -c core.quotepath=false log -\"$n\" -S\"$text\" --pretty=format:'%x01%h%x01%ad%x01%<(14,trunc)%an%x01%s' --date=short --name-only \"$@\" \
        | awk -v gry=\"$gry\" -v byl=\"$byl\" -v cyn=\"$cyn\" -v mag=\"$mag\" -v rst=\"$rst\" ' \
            substr($0,1,1)==\"\\001\" { \
                if (fc>0) { for(i=1;i<=fc;i++) { conn=(i<fc)?\"├─\":\"└─\"; printf \"%s       %s %s%s\\n\",gry,conn,files[i],rst } } \
                k=split(substr($0,2), h, \"\\001\"); s=h[4]; for(i=5;i<=k;i++) s=s h[i]; \
                printf \"\\n%s  %s %s%s %s%s %s%s\\n\",byl,h[1],cyn,h[2],mag,h[3],rst,s; \
                fc=0; delete files; next \
            } \
            /^$/ { next } \
            { files[++fc]=$0 } \
            END { if (fc>0) { for(i=1;i<=fc;i++) { conn=(i<fc)?\"├─\":\"└─\"; printf \"%s       %s %s%s\\n\",gry,conn,files[i],rst } } } \
        ' | less -RFX; \
    }; f"

    # File-level churn over all history with scaled bars
    hotspots = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git hotspots [count] [-- path]  │  Most-changed files of all time, scaled bars (default: 20)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=20; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git -c core.quotepath=false log --name-only --pretty=format: \"$@\" \
        | awk 'NF' \
        | sort | uniq -c | sort -rn \
        | head -\"$n\" \
        | awk -v yel=\"$yel\" -v cyn=\"$cyn\" -v grn=\"$grn\" -v rst=\"$rst\" '{ \
            c=$1+0; line=$0; sub(/^[ \\t]*[0-9]+[ \\t]/, \"\", line); \
            if (c>cmax) cmax=c; if (length(line)>fmax) fmax=length(line); \
            counts[NR]=c; files[NR]=line; total=NR \
        } END { \
            for (i=1;i<=total;i++) { \
                w=int(counts[i]*40/cmax); if (w<1) w=1; \
                bar=\"\"; for (j=0;j<w;j++) bar=bar\"█\"; \
                printf \"%s  %4d  %s%-*s  %s%s%s\\n\", yel, counts[i], cyn, fmax, files[i], grn, bar, rst \
            } \
        }' | less -RFX; \
    }; f"

    # Largest blobs anywhere in history — smuggled binaries show up here
    big-files = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); red=$(printf '\\033[31m'); brd=$(printf '\\033[1;31m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; red=; brd=; fi; \
        _help='git big-files [count] [-- path]  │  Largest blobs in all history; flags ones gone from HEAD (default: 15)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=15; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git rev-list --objects --all \"$@\" \
        | awk ' \
            BEGIN { \
                while ((\"git cat-file --batch-all-objects --batch-check=\\047%(objectname) %(objecttype) %(objectsize)\\047\" | getline l) > 0) { split(l, a, \" \"); if (a[2]==\"blob\") sz[a[1]]=a[3]+0 } \
                while ((\"git ls-tree -r -z HEAD 2>/dev/null | tr \\047\\\\0\\047 \\047\\\\n\\047\" | getline l) > 0) { j=index(l, \"\\t\"); if (j) live[substr(l, j+1)]=1 } \
            } \
            { i=index($0, \" \"); if (i==0) next; sha=substr($0, 1, i-1); p=substr($0, i+1); if (p==\"\" || !(sha in sz)) next; if (!(p in best) || sz[sha]>best[p]) best[p]=sz[sha] } \
            END { for (p in best) printf \"%.0f %d %s\\n\", best[p], (p in live), p }' \
        | sort -rn \
        | head -\"$n\" \
        | awk -v yel=\"$yel\" -v brd=\"$brd\" -v rst=\"$rst\" ' \
            { size=$1+0; flag=$2; line=$0; sub(/^[0-9]+ [01] /, \"\", line); \
              if (size>=1073741824) hs=sprintf(\"%.1fG\", size/1073741824); else if (size>=1048576) hs=sprintf(\"%.1fM\", size/1048576); else if (size>=1024) hs=sprintf(\"%.1fK\", size/1024); else hs=sprintf(\"%dB\", size); \
              printf \"%s  %8s  %s%-44s  %s%s%s\\n\", yel, hs, rst, line, brd, (flag==1) ? \"\" : \"gone from HEAD\", rst }' \
        | less -RFX; \
    }; f"

    # Tags newest-first — the list an auditor picks target versions from
    releases = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); yel=$(printf '\\033[33m'); byl=$(printf '\\033[1;33m'); cyn=$(printf '\\033[36m'); mag=$(printf '\\033[35m'); grn=$(printf '\\033[32m'); rst=$(printf '\\033[0m'); else gry=; bcy=; yel=; byl=; cyn=; mag=; grn=; rst=; fi; \
        _help='git releases [count] [pattern]  │  Tags newest-first with target commit (default: 15)'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        n=15; if [ \"$1\" -gt 0 ] 2>/dev/null; then n=$1; shift; fi; \
        git tag -l --sort=-creatordate --format='%(refname:short)%09%(creatordate:short)%09%(if)%(*objectname)%(then)%(*objectname:short)%(else)%(objectname:short)%(end)%09%(subject)' \"$@\" \
        | head -\"$n\" \
        | awk -F'\\t' -v byl=\"$byl\" -v cyn=\"$cyn\" -v yel=\"$yel\" -v rst=\"$rst\" '{ \
            if (length($1)>tmax) tmax=length($1); \
            t[NR]=$1; d[NR]=$2; h[NR]=$3; s=$4; for(i=5;i<=NF;i++) s=s\"\\t\"$i; sj[NR]=s; total=NR \
        } END { \
            for (i=1;i<=total;i++) { \
                printf \"%s  %-*s  %s%s  %s%s  %s%s\\n\", byl, tmax, t[i], cyn, d[i], yel, h[i], rst, sj[i] \
            } \
        }' | less -RFX; \
    }; f"


    # ╔══════════════════════════════════════════════╗
    # ║                 SHORTCUTS                    ║
    # ╚══════════════════════════════════════════════╝

    co = checkout
    br = branch
    ci = commit
    undo = reset --soft HEAD~1
    amend = commit --amend --no-edit
    stash-all = stash push --include-untracked

    # List all aliases with descriptions
    aliases = "!f() { \
        if [ -t 1 ] && [ -z \"${NO_COLOR:-}\" ]; then gry=$(printf '\\033[90m'); bcy=$(printf '\\033[1;36m'); byl=$(printf '\\033[1;33m'); rst=$(printf '\\033[0m'); else gry=; bcy=; byl=; rst=; fi; \
        _help='git aliases  │  List all aliases with descriptions'; \
        if [ \"$1\" = '-h' ] || [ \"$1\" = '--help' ]; then printf '\\n%s  ──────────────────────────────────────────────────────────────────%s\\n%s  %s%s\\n\\n' \"$gry\" \"$rst\" \"$bcy\" \"$_help\" \"$rst\"; return; fi; \
        { \
        printf '\\n%s  Custom Git Aliases%s\\n%s  ──────────────────────────────────────────────────────────────────%s\\n\\n' \"$bcy\" \"$rst\" \"$gry\" \"$rst\"; \
        git config --name-only --get-regexp '^alias\\.' | sed 's/^alias\\.//' | sort -u | while read -r name; do \
            body=$(git config --get alias.\"$name\"); \
            case \"$body\" in \
                '!'*) desc=$(printf '%s\\n' \"$body\" | sed -n \"s/.*_help='[^']*│  *\\([^']*\\)'.*/\\1/p\" | head -n 1);; \
                *)    desc=\"alias for: git $body\";; \
            esac; \
            printf '%s  %-16s %s%s%s\\n' \"$byl\" \"$name\" \"$gry\" \"$desc\" \"$rst\"; \
        done; \
        printf '\\n%s  Run git <alias> -h for usage details%s\\n\\n' \"$gry\" \"$rst\"; \
        } | less -RFX; \
    }; f"
